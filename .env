# Rename this file to .env and fill in your Gemini API key
# Get your API key from Google Cloud Console
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one
# 3. Enable the Generative AI API
# 4. Create credentials (OAuth 2.0 Client IDs)
# 5. Download the credentials JSON file
# 6. Place the JSON file in your project directory
# 7. Set the path to your credentials file in the environment variable

# Path to your service account JSON file
SERVICE_ACCOUNT_FILE="path/to/your/service-account-file.json"

# Alternatively, you can use an API key (less secure)
# GEMINI_API_KEY="your_api_key_here"